# ── SmartBiz ERP — Docker Compose Environment Variables ──────────────────
# Copy this file to .env and fill in real values before running in production.
# This file is read automatically by docker compose.
# DO NOT commit real secrets to git — add .env to .gitignore.

# JWT secret shared by all three backend services.
# Must be a Base64-encoded 256-bit (32-byte) key.
# Generate one: openssl rand -base64 32
JWT_SECRET=c21hcnRiaXotZXJwLXVzZXItc2VydmljZS1zZWNyZXQta2V5LTI1NmJpdHMhISE=

# Backend API URLs — used at frontend build time (baked into the JS bundle).
# These must be reachable from the USER'S BROWSER, not from inside Docker.
# If deploying to a server, replace localhost with your server's IP or domain.
VITE_USER_API=http://localhost:8081
VITE_INVENTORY_API=http://localhost:8082
VITE_SALES_API=http://localhost:8083

# Mongo Express web UI credentials (http://localhost:8090)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=smartbiz123
